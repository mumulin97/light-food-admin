<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap {{selected === index ? 'active' : ''}}">
      <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" />
      <text class="tab-badge" wx:if="{{index === 1 && cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</text>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
