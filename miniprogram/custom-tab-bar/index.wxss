.tab-bar {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  height: 108rpx;
  padding: 6rpx 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 38rpx rgba(35, 68, 51, 0.18), inset 0 1rpx rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
  border-radius: 24rpx;
}

.tab-item:active {
  transform: scale(0.9);
}

.tab-icon {
  width: 38rpx;
  height: 38rpx;
}

.tab-icon-wrap {
  position: relative;
  width: 58rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
  border-radius: 18rpx;
  background: transparent;
  transition: background-color .18s ease, transform .18s ease, box-shadow .18s ease;
}

.tab-icon-wrap.active {
  background: linear-gradient(145deg, #3aa477, #277a5d);
  box-shadow: 0 7rpx 16rpx rgba(42, 139, 99, 0.27), inset 0 1rpx rgba(255, 255, 255, 0.28);
  transform: translateY(-2rpx);
}

.tab-badge {
  position: absolute;
  top: -9rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 3rpx solid rgba(255,255,255,.98);
  border-radius: 999rpx;
  background: #e96952;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #87948d;
  transition: color 0.15s ease;
}

.tab-item.active .tab-text {
  color: #277a5d;
  font-weight: 750;
}
