.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 220rpx;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx 26rpx;
  background: transparent;
}

.cart-header > view { display: flex; flex-direction: column; gap: 6rpx; }

.cart-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
}

.cart-count {
  font-size: 26rpx;
  color: var(--ink-3);
}

.cart-subtitle { color: var(--ink-3); font-size: 23rpx; }
.cart-clear { padding: 14rpx 20rpx; border-radius: var(--r-pill); background: #f8ebe8; color: #bd5947; font-size: 24rpx; font-weight: 650; }

.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 30rpx 24rpx;
  padding: 120rpx 30rpx;
  border: 1rpx solid rgba(225, 234, 226, 0.9);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: var(--shadow-card);
}

.empty-icon-wrap { width: 150rpx; height: 150rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 28rpx; border-radius: 50%; background: linear-gradient(145deg,#eff8f1,#e1f0e6); }

.empty-icon {
  font-size: 82rpx;
  opacity: 0.85;
}

.empty-title { margin-bottom: 10rpx; color: var(--ink); font-size: 31rpx; font-weight: 750; }

.empty-text {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-bottom: 34rpx;
}

.order-context { display: flex; align-items: center; justify-content: space-between; margin: 0 20rpx 18rpx; padding: 22rpx 24rpx; border: 1rpx solid rgba(217,231,221,.9); border-radius: var(--r-md); background: linear-gradient(145deg,#edf8f1,#edf5f7); }
.order-context > view { min-width: 0; display: flex; flex-direction: column; gap: 7rpx; }
.order-context > view > text:first-child { color: var(--ink-3); font-size: 21rpx; }
.context-store { max-width: 430rpx; overflow: hidden; color: var(--ink); font-size: 27rpx; font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }
.context-badge { padding: 9rpx 16rpx; border-radius: var(--r-pill); background: rgba(255,255,255,.75); color: var(--brand); font-size: 21rpx; font-weight: 650; }

.empty-btn {
  background-color: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-brand);
}

.empty-btn:active {
  background-color: var(--brand-dark);
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: var(--r-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(225, 234, 226, 0.86);
}

.cart-item-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cart-item-remove { flex: 0 0 auto; padding: 8rpx 0 8rpx 14rpx; color: #b76858; font-size: 21rpx; }

.cart-item-emoji-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f3faec 0%, #e6f2da 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cart-item-emoji {
  font-size: 72rpx;
}

.cart-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cart-item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.cart-item-nutrition {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
}

.cart-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-item-price {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--accent);
}

.quantity-control {
  display: flex;
  align-items: center;
  background-color: var(--brand-050);
  border-radius: var(--r-pill);
  padding: 8rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 50%;
  font-size: 32rpx;
  color: var(--brand);
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(31, 45, 34, 0.08);
  transition: transform 0.12s ease;
}

.qty-btn:active {
  transform: scale(0.88);
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 0 16rpx;
}

/* 选项区域 */
.option-section {
  margin: 20rpx;
  padding: 28rpx 24rpx;
  background-color: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
  border: 1rpx solid rgba(225, 234, 226, 0.86);
}

.option-heading { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20rpx; }
.option-heading > view { display: flex; flex-direction: column; gap: 5rpx; }

.option-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.option-subtitle { color: var(--ink-3); font-size: 21rpx; }
.required { padding: 6rpx 12rpx; border-radius: var(--r-pill); background: var(--brand-050); color: var(--brand); font-size: 19rpx; font-weight: 650; }

.method-list {
  display: flex;
}

.method-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background-color: var(--brand-050);
  color: var(--ink-2);
  font-size: 26rpx;
  border-radius: var(--r-pill);
  margin-right: 16rpx;
  transition: all 0.15s ease;
}

.method-item:last-child {
  margin-right: 0;
}

.method-item.active {
  background-color: var(--brand);
  color: #ffffff;
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background-color: #f5f8f3;
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.name-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background-color: #f5f8f3;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.address-input { margin-top: 16rpx; }

/* 结算栏 */
.checkout-bar {
  position: fixed;
  bottom: calc(134rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: var(--card);
  z-index: 20;
  padding: 20rpx 28rpx;
  border-top: 1rpx solid rgba(225, 234, 226, 0.9);
  box-shadow: 0 -6rpx 24rpx rgba(31, 45, 34, 0.08);
}

.checkout-left {
  display: flex;
  align-items: baseline;
}

.checkout-label {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-right: 12rpx;
}

.checkout-total {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--accent);
}

.checkout-btn {
  background-color: var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 64rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-brand);
  transition: background-color 0.15s ease;
}

.checkout-btn:active {
  background-color: var(--brand-dark);
}

.checkout-btn.disabled {
  background-color: #b3bcb2;
  box-shadow: none;
}
