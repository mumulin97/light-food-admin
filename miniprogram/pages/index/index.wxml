<view class="container">
  <!-- 顶部：门店选择 + 搜索 -->
  <view class="header-wrap">
    <view class="header">
      <view class="header-left" bindtap="toggleStoreDropdown">
        <view class="store-icon">📍</view>
        <view class="store-info">
          <text class="store-name">{{currentStore.name || '选择门店'}}</text>
          <text class="store-arrow {{storeDropdownOpen ? 'open' : ''}}">▼</text>
        </view>
      </view>
      <view class="header-right {{searchOpen ? 'active' : ''}}" bindtap="toggleSearch">
        <view class="search-icon">🔍</view>
      </view>
    </view>

    <view class="search-panel" wx:if="{{searchOpen}}">
      <text class="search-prefix">⌕</text>
      <input class="search-input" value="{{searchKeyword}}" placeholder="搜索轻食、分类或标签" focus bindinput="onSearchInput" />
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">清除</text>
    </view>

    <!-- 门店下拉列表 -->
    <view class="store-dropdown {{storeDropdownOpen ? 'open' : ''}}">
      <view
        class="store-dropdown-item {{currentStore.id === item.id ? 'active' : ''}}"
        wx:for="{{stores}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="switchStore"
      >
        <text>{{item.name}}</text>
        <text class="store-check" wx:if="{{currentStore.id === item.id}}">✓</text>
      </view>
    </view>
  </view>
  <view class="store-mask" wx:if="{{storeDropdownOpen}}" bindtap="closeStoreDropdown"></view>

  <!-- Banner -->
  <view class="banner">
    <view class="banner-glow"></view>
    <view class="banner-food">🥗</view>
    <view class="banner-overlay">
      <view class="banner-copy">
        <view class="banner-tag">今日轻盈推荐</view>
        <text class="banner-title">吃得满足，也要轻负担</text>
        <text class="banner-subtitle">新鲜现制 · 营养可见 · 门店自取</text>
      </view>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-tabs" scroll-x enable-flex>
    <view
      class="category-item {{currentCategory === item ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-category="{{item}}"
      bindtap="switchCategory"
    >{{item}}</view>
  </scroll-view>

  <view class="section-heading"><view><text class="section-title">为你推荐</text><text class="section-subtitle">{{products.length}} 款轻食可选</text></view><text class="section-store">{{currentStore.name || '请选择门店'}}</text></view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 菜品列表 -->
  <view class="product-list" wx:else>
    <view class="product-card" wx:for="{{products}}" wx:key="id">
      <view class="product-image-wrapper">
        <text class="product-emoji">{{item.emoji}}</text>
      </view>
      <view class="product-info">
        <view class="product-header">
          <text class="product-category">{{item.category}}</text>
          <view class="tag tag-signature" wx:if="{{item.tag}}">{{item.tag}}</view>
        </view>
        <text class="product-name">{{item.name}}</text>
        <text class="product-nutrition">{{item.nutritionText}}</text>
        <view class="product-footer">
          <text class="product-price">¥{{item.priceText}}</text>
          <view wx:if="{{!item.soldOut && item.cartQuantity > 0}}" class="product-quantity">
            <view class="product-qty-btn minus" data-id="{{item.id}}" bindtap="decreaseCart"></view>
            <text>{{item.cartQuantity}}</text>
            <view class="product-qty-btn plus" data-id="{{item.id}}" bindtap="addToCart"></view>
          </view>
          <view wx:elif="{{!item.soldOut}}" class="btn-add" data-id="{{item.id}}" bindtap="addToCart"></view>
          <view wx:else class="tag tag-soldout">已售罄</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{products.length === 0}}">
      <text class="empty-title">没有找到相关轻食</text>
      <text class="empty-subtitle">换个分类或关键词试试</text>
      <view class="empty-reset" wx:if="{{searchKeyword}}" bindtap="clearSearch">清除搜索</view>
    </view>
  </view>

  <!-- 购物车栏 -->
  <view class="cart-bar" wx:if="{{cartTotalItems > 0}}">
    <view class="cart-left">
      <view class="cart-icon-wrapper">
        <text class="cart-icon">🛒</text>
        <view class="cart-badge" wx:if="{{cartTotalItems > 0}}">{{cartTotalItems}}</view>
      </view>
      <view class="cart-info">
        <text class="cart-items">{{cartTotalItems}} 件</text>
        <text class="cart-total">合计 ¥{{cartTotalAmount}}</text>
      </view>
    </view>
    <view class="checkout-btn" bindtap="goToCheckout">去结算</view>
  </view>
</view>
