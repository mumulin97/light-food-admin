<view class="container">
  <view class="cart-header">
    <view><text class="cart-title">确认订单</text><text class="cart-subtitle">核对商品和取餐信息</text></view>
    <text class="cart-clear" wx:if="{{cartItems.length > 0}}" bindtap="clearCart">清空</text>
  </view>

  <!-- 空购物车 -->
  <view class="cart-empty" wx:if="{{cartItems.length === 0}}">
    <view class="empty-icon-wrap"><text class="empty-icon">🛒</text></view>
    <text class="empty-title">购物车还是空的</text>
    <text class="empty-text">去挑选一份今天想吃的轻食吧</text>
    <view class="empty-btn" bindtap="goToMenu">去点单</view>
  </view>

  <block wx:else>
    <view class="order-context">
      <view><text>取餐门店</text><text class="context-store">{{storeName}}</text></view>
      <text class="context-badge">{{totalItems}} 件商品</text>
    </view>

    <!-- 商品列表 -->
    <view class="cart-list">
      <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
        <view class="cart-item-emoji-wrapper">
          <text class="cart-item-emoji">{{item.emoji}}</text>
        </view>
        <view class="cart-item-info">
          <view class="cart-item-title"><text class="cart-item-name">{{item.name}}</text><text class="cart-item-remove" data-id="{{item.id}}" bindtap="removeItem">移除</text></view>
          <text class="cart-item-nutrition">{{item.nutritionText}}</text>
          <view class="cart-item-footer">
            <text class="cart-item-price">¥{{item.priceText}}</text>
            <view class="quantity-control">
              <view class="qty-btn" data-id="{{item.id}}" bindtap="decreaseQty">-</view>
              <text class="qty-num">{{item.quantity}}</text>
              <view class="qty-btn" data-id="{{item.id}}" bindtap="increaseQty">+</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 就餐方式 -->
    <view class="option-section">
      <view class="option-heading"><view><text class="option-title">就餐方式</text><text class="option-subtitle">选择本次订单的履约方式</text></view><text class="required">必选</text></view>
      <view class="method-list">
        <view
          class="method-item {{methodIndex === index ? 'active' : ''}}"
          wx:for="{{methods}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="switchMethod"
        >{{item}}</view>
      </view>
    </view>

    <!-- 姓名 -->
    <view class="option-section">
      <view class="option-heading"><view><text class="option-title">取餐信息</text><text class="option-subtitle">用于门店核对订单</text></view></view>
      <input
        class="name-input"
        placeholder="请输入取餐人姓名"
        value="{{customerName}}"
        bindinput="onNameInput"
        maxlength="20"
      />
      <input
        wx:if="{{methodIndex === 2}}"
        class="name-input address-input"
        placeholder="请输入配送地址"
        value="{{deliveryAddress}}"
        bindinput="onAddressInput"
        maxlength="80"
      />
    </view>

    <!-- 备注 -->
    <view class="option-section">
      <view class="option-heading"><view><text class="option-title">订单备注</text><text class="option-subtitle">选填，门店会尽量满足</text></view></view>
      <textarea
        class="note-input"
        placeholder="如有特殊需求请填写（少冰、不要香菜等）"
        value="{{note}}"
        bindinput="onNoteInput"
        maxlength="100"
      />
    </view>

    <!-- 结算栏 -->
    <view class="checkout-bar">
      <view class="checkout-left">
        <text class="checkout-label">{{totalItems}} 件 · 合计</text>
        <text class="checkout-total">¥{{totalAmount}}</text>
      </view>
      <view class="checkout-btn {{submitting ? 'disabled' : ''}}" bindtap="submitOrder">
        {{submitting ? '提交中...' : '提交订单'}}
      </view>
    </view>
  </block>
</view>
