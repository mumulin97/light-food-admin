.container { min-height: 100vh; padding-bottom: 150rpx; background: var(--bg); }
.profile-hero { position: relative; overflow: hidden; margin: 20rpx; padding: 36rpx 32rpx 30rpx; border-radius: 34rpx; background: linear-gradient(145deg,#245f49 0%,#378667 58%,#77b98c 100%); box-shadow: 0 18rpx 38rpx rgba(37,95,73,.24); color: #fff; }
.hero-orb { position: absolute; top: -100rpx; right: -70rpx; width: 310rpx; height: 310rpx; border-radius: 50%; background: radial-gradient(circle,rgba(255,255,255,.3),rgba(255,255,255,0) 68%); }
.profile-identity { position: relative; z-index: 2; display: flex; align-items: center; }
.avatar-wrapper { width: 126rpx; height: 126rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin-right: 24rpx; border: 4rpx solid rgba(255,255,255,.62); border-radius: 36rpx; background: rgba(255,255,255,.2); box-shadow: 0 12rpx 26rpx rgba(15,55,39,.18); }
.avatar-icon { font-size: 72rpx; }
.user-info { min-width: 0; display: flex; flex-direction: column; }
.name-row { display: flex; align-items: center; gap: 14rpx; }
.user-name { max-width: 280rpx; overflow: hidden; font-size: 36rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.edit-name { padding: 6rpx 13rpx; border: 1rpx solid rgba(255,255,255,.36); border-radius: var(--r-pill); background: rgba(255,255,255,.13); color: rgba(255,255,255,.92); font-size: 19rpx; }
.user-id { margin-top: 8rpx; color: rgba(255,255,255,.74); font-size: 21rpx; }
.member-level { align-self: flex-start; margin-top: 12rpx; padding: 7rpx 15rpx; border-radius: var(--r-pill); background: rgba(231,246,225,.19); color: #efffe9; font-size: 20rpx; font-weight: 650; }
.profile-slogan { position: relative; z-index: 2; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; margin-top: 30rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.18); }
.profile-slogan > text:first-child { font-size: 27rpx; font-weight: 700; }.profile-slogan > text:last-child { color: rgba(255,255,255,.7); font-size: 20rpx; }

.profile-stats { display: grid; grid-template-columns: repeat(3,1fr); margin: -2rpx 20rpx 20rpx; padding: 20rpx 0; border: 1rpx solid rgba(224,234,226,.9); border-radius: var(--r-lg); background: rgba(255,255,255,.9); box-shadow: var(--shadow-card); }
.profile-stats > view { min-height: 74rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; border-left: 1rpx solid var(--line); color: var(--ink-3); font-size: 21rpx; }
.profile-stats > view:first-child { border-left: 0; }.stat-number { color: var(--ink); font-size: 31rpx; font-weight: 800; }
.stat-state { color: #a87527; font-size: 24rpx; font-weight: 750; }.stat-state.ready { color: var(--brand); }

.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 28rpx 28rpx 15rpx; }
.section-heading > view { display: flex; flex-direction: column; gap: 5rpx; }
.section-heading > view > text:first-child { color: var(--ink); font-size: 27rpx; font-weight: 750; }
.section-heading > view > text:last-child { color: var(--ink-3); font-size: 20rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 14rpx; margin: 0 20rpx; }
.quick-item { min-width: 0; display: grid; grid-template-columns: 64rpx minmax(0,1fr); grid-template-rows: auto auto; column-gap: 16rpx; row-gap: 5rpx; align-items: center; padding: 22rpx; border: 1rpx solid rgba(224,234,226,.9); border-radius: var(--r-lg); background: rgba(255,255,255,.9); box-shadow: var(--shadow-card); }
.quick-item:active { background: var(--brand-050); transform: scale(.98); }
.quick-icon { grid-row: 1 / 3; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; font-size: 30rpx; }
.quick-icon.green { background: var(--brand-050); color: var(--brand); }.quick-icon.amber { background: #fff2df; color: #a86b1c; }.quick-icon.blue { background: #e8f2f8; color: #397e9e; }.quick-icon.violet { background: #f0ebf8; color: #765aa0; }
.quick-title { overflow: hidden; color: var(--ink); font-size: 25rpx; font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }.quick-desc { overflow: hidden; color: var(--ink-3); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }

.store-heading { margin-top: 30rpx; }
.current-store-card { display: flex; align-items: center; gap: 18rpx; margin: 0 20rpx 24rpx; padding: 24rpx; border: 1rpx solid rgba(215,231,221,.9); border-radius: var(--r-lg); background: linear-gradient(145deg,#edf8f1,#edf4f7); box-shadow: var(--shadow-card); }
.store-card-icon { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 20rpx; background: rgba(255,255,255,.8); color: var(--brand); font-size: 34rpx; }
.current-store-card > view:nth-child(2) { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 5rpx; }
.card-eyebrow { color: var(--ink-3); font-size: 20rpx; }.store-card-name { overflow: hidden; color: var(--ink); font-size: 28rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }.store-card-address { overflow: hidden; color: var(--ink-3); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.store-actions { flex: 0 0 auto; display: flex; flex-direction: column; gap: 8rpx; }
.store-actions > text { min-width: 74rpx; padding: 10rpx 13rpx; border: 1rpx solid rgba(77,151,103,.25); border-radius: var(--r-pill); background: rgba(255,255,255,.7); color: var(--brand); font-size: 20rpx; font-weight: 650; text-align: center; }
.more-heading { margin-top: 28rpx; }

.menu-list { margin: 0 20rpx; overflow: hidden; border: 1rpx solid rgba(224,234,226,.9); border-radius: var(--r-lg); background: rgba(255,255,255,.9); box-shadow: var(--shadow-card); }
.menu-item { display: flex; align-items: center; gap: 18rpx; padding: 25rpx 24rpx; border-bottom: 1rpx solid var(--line); }.menu-item:last-child { border-bottom: 0; }.menu-item:active { background: var(--brand-050); }
.menu-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; border-radius: 16rpx; background: var(--brand-050); color: var(--brand); font-size: 28rpx; }
.menu-item > view { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 5rpx; }.menu-text { color: var(--ink); font-size: 26rpx; font-weight: 650; }.menu-desc { overflow: hidden; color: var(--ink-3); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }.menu-arrow { flex: 0 0 auto; color: #abb6ae; font-size: 34rpx; }
.profile-footnote { display: block; margin: 28rpx 20rpx 0; color: var(--ink-3); font-size: 20rpx; text-align: center; }
