.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 140rpx;
}

.orders-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background-color: var(--card);
}

.orders-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
}

.refresh-btn {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--brand-050);
  border-radius: 50%;
  font-size: 36rpx;
  color: var(--brand);
  transition: transform 0.3s ease;
}

.refresh-btn:active {
  transform: rotate(180deg);
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  color: var(--ink-3);
  font-size: 28rpx;
}

.orders-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-bottom: 40rpx;
}

.empty-btn {
  background-color: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-brand);
}

.empty-btn:active {
  background-color: var(--brand-dark);
}

.orders-list {
  padding: 20rpx;
}

.order-card {
  background-color: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-id {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  background-color: var(--brand-050);
  border-radius: var(--r-pill);
}

.order-items {
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  padding: 12rpx 0;
  margin-bottom: 20rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.order-item-name {
  font-size: 26rpx;
  color: var(--ink);
}

.order-item-qty {
  font-size: 26rpx;
  color: var(--ink-3);
}

.loading-items {
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  padding: 20rpx 0;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-meta {
  display: flex;
  flex-direction: column;
}

.order-method {
  font-size: 22rpx;
  color: var(--brand);
  background-color: var(--brand-050);
  padding: 6rpx 16rpx;
  border-radius: var(--r-pill);
  margin-bottom: 8rpx;
  align-self: flex-start;
}

.order-time {
  font-size: 24rpx;
  color: var(--ink-3);
}

.order-total {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--accent);
}

.order-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background-color: #fff8e9;
  border-radius: var(--r-md);
}

.note-label {
  font-size: 22rpx;
  color: #f5a623;
  font-weight: 600;
}

.note-text {
  font-size: 24rpx;
  color: var(--ink-2);
}
