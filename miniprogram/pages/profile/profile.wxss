.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 140rpx;
}

/* 品牌绿渐变头部 */
.profile-header {
  display: flex;
  align-items: center;
  padding: 72rpx 40rpx 56rpx;
  background: linear-gradient(150deg, #3a9440 0%, #2e7d32 55%, #1f5e24 100%);
}

.avatar-wrapper {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-icon {
  font-size: 64rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.menu-list {
  margin: -32rpx 20rpx 0;
  background-color: var(--card);
  border-radius: var(--r-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background-color 0.15s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: var(--brand-050);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background-color: var(--brand-050);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.menu-arrow {
  font-size: 32rpx;
  color: #c4ccc3;
}
