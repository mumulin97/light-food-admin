.container {
  min-height: 100vh;
  background-color: var(--bg);
  padding-bottom: 220rpx;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 32rpx;
  background-color: var(--card);
}

.cart-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
}

.cart-count {
  font-size: 26rpx;
  color: var(--ink-3);
}

.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-bottom: 40rpx;
}

.empty-btn {
  background-color: var(--brand);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-brand);
}

.empty-btn:active {
  background-color: var(--brand-dark);
}

.cart-list {
  padding: 20rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  background-color: var(--card);
  border-radius: var(--r-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.cart-item-emoji-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #f3faec 0%, #e6f2da 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cart-item-emoji {
  font-size: 72rpx;
}

.cart-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.cart-item-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.cart-item-nutrition {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-bottom: 16rpx;
}

.cart-item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-item-price {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--accent);
}

.quantity-control {
  display: flex;
  align-items: center;
  background-color: var(--brand-050);
  border-radius: var(--r-pill);
  padding: 8rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 50%;
  font-size: 32rpx;
  color: var(--brand);
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(31, 45, 34, 0.08);
  transition: transform 0.12s ease;
}

.qty-btn:active {
  transform: scale(0.88);
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 0 16rpx;
}

/* 选项区域 */
.option-section {
  margin: 20rpx;
  padding: 28rpx 24rpx;
  background-color: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

.option-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.method-list {
  display: flex;
}

.method-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background-color: var(--brand-050);
  color: var(--ink-2);
  font-size: 26rpx;
  border-radius: var(--r-pill);
  margin-right: 16rpx;
  transition: all 0.15s ease;
}

.method-item:last-child {
  margin-right: 0;
}

.method-item.active {
  background-color: var(--brand);
  color: #ffffff;
  font-weight: 600;
  box-shadow: var(--shadow-brand);
}

.note-input {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background-color: #f5f8f3;
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.name-input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  background-color: #f5f8f3;
  border-radius: var(--r-md);
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

/* 结算栏 */
.checkout-bar {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: var(--card);
  padding: 24rpx 32rpx;
  box-shadow: 0 -6rpx 24rpx rgba(31, 45, 34, 0.08);
}

.checkout-left {
  display: flex;
  align-items: baseline;
}

.checkout-label {
  font-size: 28rpx;
  color: var(--ink-2);
  margin-right: 12rpx;
}

.checkout-total {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--accent);
}

.checkout-btn {
  background-color: var(--brand);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 64rpx;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-brand);
  transition: background-color 0.15s ease;
}

.checkout-btn:active {
  background-color: var(--brand-dark);
}

.checkout-btn.disabled {
  background-color: #b3bcb2;
  box-shadow: none;
}
